+                return
+            with self.path.open("rb") as file:
+                file.seek(-1, os.SEEK_END)
+                last = file.read(1)
+            if last != b"\n":
+                with self.path.open("ab") as file:
+                    file.write(b"\n")
+                    file.flush()
+                    os.fsync(file.fileno())
+        except OSError as exc:
+            logger.error("No se pudo verificar el final de %s: %s", self.path, exc)
