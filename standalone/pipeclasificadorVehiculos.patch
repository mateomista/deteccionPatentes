+    def _ensure_trailing_newline(self) -> None:
+        """Si una escritura anterior quedó cortada (sin '\\n' final), el próximo registro se
+        pegaría a esa línea y se perderían los dos. Se cierra la línea parcial antes de anexar."""
+        try:
