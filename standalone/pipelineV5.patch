 # ==============================================================================
 # PIPELINE MODULAR
 # ==============================================================================
+# ==============================================================================
+# CONTRATO PRODUCTOR-CONSUMIDOR (misma lógica que alpr/contracts.py)
+# ==============================================================================
+# El pipeline escribe, por cada vehículo cuya patente quedó registrada, UN recorte del vehículo
+# completo como vehiculo_<track_id>__<video>.jpg, de forma atómica (.tmp -> renombrar). El video va en
+# el nombre porque el track_id de ByteTrack se reinicia en cada video.
+_UNSAFE_NAME_CHARS = re.compile(r"[^A-Za-z0-9._-]+")
+
+
+def sanitize_video_stem(stem):
+    """Deja solo caracteres seguros para un nombre de archivo (también en Windows)."""
+    return _UNSAFE_NAME_CHARS.sub("-", str(stem)).strip("-._") or "video"
+
+
+def vehicle_crop_filename(track_id, video_stem=None, ext=".jpg"):
+    if int(track_id) < 0:
+        raise ValueError(f"track_id inválido: {track_id}")
+    name = f"vehiculo_{int(track_id)}"
+    if video_stem:
+        name += f"__{sanitize_video_stem(video_stem)}"
+    return name + ext
+
+
+def write_image_atomic(path, image, jpeg_quality=95, retries=3, delay=0.1):
+    """Escribe `image` de forma atómica (a <path>.tmp y luego os.replace). Codifica con imencode:
+    funciona con rutas con tildes en Windows, donde cv2.imwrite falla. Reintenta ante bloqueos."""
+    parent = os.path.dirname(path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    ext = os.path.splitext(path)[1].lower() or ".jpg"
+    params = [int(cv2.IMWRITE_JPEG_QUALITY), int(jpeg_quality)] if ext in (".jpg", ".jpeg") else []
+    ok, buf = cv2.imencode(ext, image, params)
+    if not ok:
+        raise ValueError(f"No se pudo codificar la imagen como {ext}")
+    tmp = path + ".tmp"
+    last_exc = None
+    for attempt in range(1, retries + 1):
+        try:
+            with open(tmp, "wb") as f:
+                f.write(buf.tobytes())
+                f.flush()
+                os.fsync(f.fileno())
+            os.replace(tmp, path)
+            return path
+        except OSError as exc:
+            last_exc = exc
+            time.sleep(delay * attempt)
+    try:
+        os.remove(tmp)
+    except OSError:
+        pass
+    raise OSError(f"No se pudo escribir {path} tras {retries} intentos: {last_exc}")
+
+
